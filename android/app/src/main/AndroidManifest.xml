<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Accès à Internet (API Django sur Railway + Firebase) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Autorisation d'afficher les notifications (Android 13 et plus) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibration lors des notifications -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="Parcelles Veto"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Thème affiché pendant le chargement de Flutter -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ─── Notifications Firebase (app en arrière-plan / fermée) ─── -->
        <!-- Icône utilisée par Android pour les notifications FCM -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <!-- Canal par défaut : doit être identique au channel_id du serveur -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="parcelle_veto_v2" />

        <!-- Ne pas supprimer : utilisé par Flutter pour enregistrer les plugins -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Requis par Flutter pour le traitement du texte -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>